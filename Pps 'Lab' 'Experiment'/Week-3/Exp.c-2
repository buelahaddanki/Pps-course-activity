#include<stdio.h>
#include<math.h>
int main()
{
    float p,r,t,amount,ci;
    printf("Enter principal:");
    scanf("%f", &p);
    printf("Enter rate:");
    scanf("%f", &r);
    printf("Enter time:");
    scanf("%f", &t);
    amount=p*((pow((1+r/100),t)));
    ci=amount-p;
    printf("compound intrest=%.2f",ci);
}
