#include<stdio.h>
int main()
{
  int units;
  float bill;
  printf("Enter units consumed:");
  scanf("%d", &units);
  if(units<0)
  {
      printf("Invalid units\n");
  }
  else if(units <= 100)
  {
      bill = units*1.50;
      printf("Electricity Bill = Rs.%.2f\n",bill);
  }
  else if(units <= 200)
  {
      bil = units*2.50;
      printf("Electicity Bill = Rs.%.2f\n",bill);
  }
  else if(units <= 500)
  {
      bill = units*4.00;
      printf("Electicity Bill = Rs.%.2f\n",bill);
  }
  else
  {
      bill = units*6.00
      printf("Electivity Bill = Rs.%.2f\n",bill);
  }
}


 
