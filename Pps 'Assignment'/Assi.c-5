#include<stduo.h>
int main()
{
    int age,creditscore;
    float income;
    int membership;
   printf("Enter age:");
   scanf("%d", &age);
   printf("Enter monthly income:");
   scanf("%f", &income);
   printf("Enter creditscore:");
   scanf("%d", &creditscore);
   if(age<21||age>60)
   {
        printf("Loan rejected:age not in 21to60");
   }
   else if(income<2500)
   {
        printf("Loan rejected:income below Rs.2500");
   }
   else if(creditscore<700)
   {
        printf("Loan rejected:credit score below 700");
   }
   else
   {
        printf("Loan approved");
   }
}

  
