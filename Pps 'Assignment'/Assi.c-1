#include<stdio.h>
int main()
{
    int no;
    printf("\n Enter a number");
    scanf("%d", &no);
    if(no>0)
    {
        printf("\n %d is a positive number");
    }
    else if(no<0)
    {
        printf("\n %d is negative number");
    }
    else
    {
        printf("\n  the  number is zero");
    }
}
